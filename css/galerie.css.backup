/* ===== GALERIE_3.CSS — Styles spécifiques à la page galerie ===== */

:root {
    --couleur-sable: #C5A059;
    --couleur-or: #C5A059;
    --couleur-noir: #1a1a1a;
    --couleur-charcoal: #2c2c2c;
    --couleur-fond: #f8f9fa;
    --couleur-blanc: #ffffff;
    --police-titre: 'Playfair Display', serif;
    --police-texte: 'Montserrat', sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: var(--police-texte);
    background-color: var(--couleur-fond);
    color: var(--couleur-charcoal);
}

/* ----- HERO SECTION & TITRES ----- */
.hero-section {
    position: relative;
    width: 100%;
    height: 320px;
    background-image: url('../images/piscinehorizon.jpg');
    background-position: center;
    background-size: cover;
}

.hero-overlay {
    background: rgba(26, 26, 26, 0.45);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.hero-content {
    text-align: left;
    width: 85%;
    max-width: 1200px;
    color: var(--couleur-blanc);
}

.hero-content h1 {
    font-family: var(--police-titre);
    font-size: 52px;
    font-weight: 400;
    letter-spacing: 6px;
    margin-bottom: 10px;
    color: var(--couleur-blanc);
    text-transform: uppercase;
}

.hero-content p {
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 25px;
    font-weight: 300;
    opacity: 0.95;
}

.btn-explore {
    background: transparent;
    border: 1px solid var(--couleur-blanc);
    color: var(--couleur-blanc);
    padding: 10px 22px;
    font-size: 11px;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s;
}

.btn-explore:hover {
    background: var(--couleur-blanc);
    color: var(--couleur-noir);
}

/* ----- BOUTONS DE FILTRES (PASTILLES) ----- */
.gallery-container {
    padding: 40px 4% 20px 4%;
    text-align: center;
    margin: 0 auto;
    max-width: 96%;
}

.gallery-filters {
    margin-bottom: 40px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}

.filter-btn {
    background: #f1f1f1;
    border: 1px solid #e0e0e0;
    padding: 9px 22px;
    font-size: 13px;
    color: var(--couleur-charcoal);
    cursor: pointer;
    border-radius: 30px;
    font-family: var(--police-texte);
    transition: all 0.2s ease;
}

.filter-btn.active, .filter-btn:hover {
    background-color: var(--couleur-or);
    border-color: var(--couleur-or);
    color: var(--couleur-blanc);
}

/* ----- GRILLE & BANDE TRANSPARENTE ----- */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.grid-item {
    position: relative;
    height: 300px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    border-radius: 4px;
}

.grid-item img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
}

.item-large {
    grid-column: span 2;
}

.item-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 35px 20px 20px 20px;
    background: linear-gradient(to top, rgba(26,26,26,0.95) 0%, rgba(26,26,26,0.5) 60%, rgba(26,26,26,0) 100%);
    color: var(--couleur-blanc);
    text-align: left;
    z-index: 2;
}

.item-caption h3 {
    font-size: 13px;
    letter-spacing: 1.2px;
    margin-bottom: 3px;
    color: var(--couleur-blanc);
    font-weight: 600;
    text-transform: uppercase;
}

.item-caption p {
    font-size: 11px;
    opacity: 0.85;
    color: #dcdcdc;
    margin: 0;
}

/* ----- RESPONSIVENESS GALERIE ----- */
@media (max-width: 1024px) {
    .footer-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .gallery-grid {
        grid-template-columns: 1fr;
    }
    .grid-item.item-large {
        grid-column: span 1;
    }
}
/* ============================================================= */
/* FALLBACK HERO GALERIE                                         */
/* Garantit un fond visible même si l'image est absente          */
/* ============================================================= */
.hero-section {
    /* Dégradé de secours : bleu océan → vert Pullman */
    background-color: #0A1E2D;
    background-image:
        linear-gradient(120deg, rgba(10, 30, 45, 0.75) 0%, rgba(21, 94, 117, 0.55) 100%),
        url('../images/hero.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

/* Si l'image inline se charge, elle prend le dessus */
.hero-section[style*="background-image"] {
    background-color: transparent;
}

/* Hauteur responsive garantie */
@media (max-width: 768px) {
    .hero-section { height: 280px; }
}
@media (max-width: 480px) {
    .hero-section { height: 240px; }
}
